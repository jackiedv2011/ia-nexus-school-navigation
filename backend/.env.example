# IA Nexus backend — environment template.
# Copy this file to ".env" (which is gitignored) and fill in REAL values there.
# NEVER put real secrets in this example file.

# --- Core ---
NODE_ENV=development           # set to "production" on Render
PORT=3001

# --- Database (REQUIRED; server refuses to boot without it) ---
# Postgres connection string from Supabase: Project Settings → Database →
# Connect → "Transaction pooler" (port 6543). Use that one, not the direct
# connection string at the top of that page — the direct URL is IPv6-only and
# won't resolve from most hosts/dev machines.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres
# TLS is chosen automatically: on for a remote host, off for localhost (which
# does not speak it). Add "?sslmode=disable" or "?sslmode=require" to override.
# Set DB_SSL_STRICT=1 to actually verify the server certificate.
DB_SSL_STRICT=
# Optional: run against a separate Postgres schema instead of "public" — used
# by the test suite to get an isolated, disposable namespace on the same
# Supabase project. Leave unset for normal dev/production use.
DB_SCHEMA=
# Optional: max concurrent Postgres connections this process opens (default 20).
# Check your actual Supabase plan's pooler connection limit (Project Settings →
# Database → Connection pooling) before raising this further.
DB_POOL_MAX=

# --- Frontend origin (used to build links in emails, e.g. "verify your email") ---
# SECURITY: this is never derived from the request's Host header, because that
# header is set by the caller. It used to be, which let anyone make this app
# email a real person a genuine-looking link pointing at the attacker's own
# domain. Resolution order is now:
#   1. FRONTEND_URL          (below) — always wins
#   2. RENDER_EXTERNAL_URL   — set automatically by Render, so a normal deploy
#                              there needs no configuration at all
#   3. a request Host that appears in ALLOWED_HOSTS (see below)
#   4. nothing — the email is skipped rather than sent with a poisoned link
# Set this to the app's public URL if you deploy anywhere other than Render.
# In development it defaults to http://localhost:5183 (Vite's port for this
# project), because Vite's proxy rewrites the Host header.
FRONTEND_URL=

# Optional. Comma-separated hosts ("nexus.example.org,www.nexus.example.org")
# whose incoming Host header may be used to build email links when neither
# FRONTEND_URL nor RENDER_EXTERNAL_URL is set. Only needed for a deployment
# that legitimately answers on several hostnames. Anything not listed here is
# refused, so leaving it empty is the safe default.
ALLOWED_HOSTS=

# --- Signup restriction (optional; audit H2/M2) ---
# Comma-separated list of email domains allowed to register. Leave empty/unset to
# allow open registration. Example: students.example.org,example.org
ALLOWED_EMAIL_DOMAINS=

# --- Auth (REQUIRED in production; server refuses to boot without it) ---
# Generate a long random value, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# --- AI provider (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Optional: global ceiling on interactive-mode AI calls per minute/hour, across
# ALL users combined (default 60/min, 1000/hour). This is a real cost control —
# raising it increases your Anthropic bill exposure, so pick a number based on
# your actual expected concurrent usage and acceptable spend, not just "higher".
AI_GLOBAL_PER_MIN=
AI_GLOBAL_PER_HOUR=

# --- Load protection (optional) ---
# Hard ceiling on requests being handled at once. Past this the server returns a
# fast 503 with Retry-After instead of accepting work it cannot finish — Node has
# no natural back pressure and will otherwise run itself out of memory. Default
# 2000. A real bell (1,500 students at once) completes in ~1.2s, well under this;
# the ceiling exists for what is not a bell.
MAX_INFLIGHT=
# Maximum simultaneous TCP connections. Default 10000.
MAX_CONNECTIONS=

# --- Rate limiting (optional) ---
# Per-IP request ceiling per minute for guest-accessible endpoints (guest chat,
# route finder, signup/login, feedback). Default 4000/min, sized for an entire
# school (~1,500 students) sharing one public IP/NAT — NOT a per-student limit.
# Tune from real observed beta traffic.
RATE_IP_MAX=

# --- Admin dashboard (optional; gates /admin's API, NOT tied to user accounts) ---
# Generate a long random value, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave unset to disable the dashboard entirely.
ADMIN_KEY=

# --- Email (SMTP, for password-reset codes) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-gmail-app-password     # a Google "App Password", not your login password
EMAIL_FROM=you@gmail.com
EMAIL_FROM_NAME=IA Nexus
EMAIL_REPLY_TO=you@gmail.com
